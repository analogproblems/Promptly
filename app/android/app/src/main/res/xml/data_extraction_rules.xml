<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of Promptly's goes into a backup or a move to a new phone
     (Android 12 and later). The database and saved secrets are encrypted
     with a key kept in this phone's Keystore, which never leaves it, so a
     copy restored elsewhere could not be opened and would lock the app.
     Sync is how hosts and keys reach another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
